<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFF6FF">

    <!-- Círculo de pulso atrás da logo (sem arquivo extra) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/viewPulso"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:alpha="0"
        app:cardBackgroundColor="#BFDBFE"
        app:cardCornerRadius="110dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="@id/cardLogo"
        app:layout_constraintEnd_toEndOf="@id/cardLogo"
        app:layout_constraintStart_toStartOf="@id/cardLogo"
        app:layout_constraintTop_toTopOf="@id/cardLogo" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardLogo"
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:alpha="0"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="85dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.32"
        app:strokeColor="#DBEAFE"
        app:strokeWidth="2dp">

        <ImageView
            android:id="@+id/imgLogoLoading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Logo C.A.S.A."
            android:padding="26dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/img_logo" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/txtNomeApp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:alpha="0"
        android:letterSpacing="0.15"
        android:text="C.A.S.A."
        android:textAlignment="center"
        android:textColor="#0F172A"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardLogo" />

    <TextView
        android:id="@+id/txtSlogan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="40dp"
        android:alpha="0"
        android:text="Se expressar, conectar e descobrir"
        android:textAlignment="center"
        android:textColor="#475569"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtNomeApp" />

    <!-- Barra de progresso -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/barraProgresso"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="16dp"
        android:alpha="0"
        android:max="100"
        android:progress="0"
        app:indicatorColor="#2563EB"
        app:layout_constraintBottom_toTopOf="@id/txtStatus"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:trackColor="#DBEAFE"
        app:trackCornerRadius="8dp"
        app:trackThickness="8dp" />

    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:alpha="0"
        android:text="Iniciando..."
        android:textAlignment="center"
        android:textColor="#64748B"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>